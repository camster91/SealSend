# Database
DATABASE_URL=postgresql://sealsend:PASSWORD@db:5432/sealsend

# App
NEXT_PUBLIC_SITE_URL=https://sealsend.app
# Server-side canonical URL. Set at runtime in Docker/Coolify.
APP_URL=https://sealsend.app

# AI-assisted event drafting. Prompts are sent server-side and SealSend requests
# that OpenAI not store Responses API output. Leave the key blank to use the
# conservative local fallback instead.
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
OPENAI_API_KEY=

# ═══════════════════════════════════════════════════════════════
# EMAIL CONFIGURATION (Mailgun)
# ═══════════════════════════════════════════════════════════════
MAILGUN_API_KEY=your-mailgun-sending-key  # Get from https://app.mailgun.com/settings/api_security
MAILGUN_DOMAIN=sealsend.app               # Your verified Mailgun domain
MAILGUN_URL=https://api.mailgun.net       # Use https://api.eu.mailgun.net for EU region
FROM_EMAIL="SealSend <noreply@sealsend.app>"

# Mailgun Webhook Signing Key (optional, for webhook verification)
# MAILGUN_WEBHOOK_SIGNING_KEY=xxxxxxxxxxxxxxx

# Titan Email (IMAP/SMTP) - Optional backup
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_USER=contact@sealsend.app
TITAN_IMAP_PASSWORD=your-titan-app-password
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_USER=contact@sealsend.app
TITAN_SMTP_PASSWORD=your-titan-app-password
TITAN_DEFAULT_FROM="Seal & Send <contact@sealsend.app>"

# ═══════════════════════════════════════════════════════════════
# SMS CONFIGURATION (Twilio)
# ═══════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_API_KEY_SID=your-twilio-api-key-sid
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
# OR use a specific From number:
# TWILIO_FROM_NUMBER=+15551234567

# Twilio Webhook (optional, for delivery tracking)
TWILIO_WEBHOOK_URL=https://yourdomain.com/api/webhooks/twilio

# ═══════════════════════════════════════════════════════════════
# PAYMENTS (Stripe)
# ═══════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRO_YEARLY_PRICE_ID=price_your-pro-annual-price-id
PAYMENTS_TEST_ONLY=true
COMMUNICATIONS_TEST_ONLY=true
# Comma-separated exact email addresses and E.164 phone numbers approved for test sends.
COMMUNICATIONS_ALLOWED_RECIPIENTS=
MAILGUN_WEBHOOK_SIGNING_KEY=
TWILIO_WEBHOOK_URL=https://your-domain.example/api/webhooks/twilio

# ═══════════════════════════════════════════════════════════════
# OPTIONAL SETTINGS
# ═══════════════════════════════════════════════════════════════

# Security
SESSION_SECRET=your-session-secret-min-32-chars-long
TRUST_PROXY_HEADERS=false

# Rate Limiting (Redis recommended for production)
# REDIS_URL=redis://localhost:6379

# Feature Flags
# ENABLE_SMS=true
# ENABLE_EMAIL_DEBUG=false

# Default Country for Phone Numbers (ISO 3166-1 alpha-2)
DEFAULT_COUNTRY=US

# ═══════════════════════════════════════════════════════════════
# AUTOMATIC REMINDERS (Cron Job)
# ═══════════════════════════════════════════════════════════════
# Secret key for authenticating cron requests (generate a secure random string)
CRON_SECRET=your-secure-cron-secret-min-32-chars-long

# Hours before event to send reminders (default: 48)
REMINDER_HOURS_BEFORE=48

# Window to check for events (default: 24 - checks events happening in next 24-48 hours)
REMINDER_CHECK_WINDOW_HOURS=24

