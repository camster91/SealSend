{
  "cli": {
    "requireCommit": true,
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    }
  }
}
